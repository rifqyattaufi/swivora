<ui:FluentWindow x:Class="WorkspaceLauncher.App.ConfigWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Settings" Width="1040" Height="680" MinWidth="880" MinHeight="560"
                 WindowStartupLocation="CenterScreen" WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <!-- selection that stays readable in light and dark: neutral fill plus an accent bar -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMaximize="True" ShowMinimize="True" />

        <TabControl Grid.Row="1" Margin="16,0,16,0" x:Name="Tabs">
            <!-- Apps -->
            <TabItem Header="Apps">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Modes and workspaces" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <ui:Button Content="Add workspace" HorizontalAlignment="Stretch" Click="OnAddWorkspace" />
                            <ui:Button x:Name="RemoveTarget" Content="Remove workspace" HorizontalAlignment="Stretch"
                                       Margin="0,8,0,0" Click="OnRemoveWorkspace" />
                        </StackPanel>
                        <ListBox x:Name="Targets" SelectionChanged="OnTargetChanged" AutomationProperties.Name="Modes and workspaces">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="2" x:Name="AppsPane">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Name" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ui:TextBox x:Name="TargetName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Workspace name" />
                            <TextBlock Text="Apps" Style="{StaticResource FieldLabel}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button Content="Add app" Click="OnAddApp" />
                            <ui:Button Content="Remove" Margin="8,0,0,0" Click="OnRemoveApp" />
                        </StackPanel>
                        <Grid>
                        <TextBlock x:Name="NoAppsText" Style="{StaticResource Caption}" FontSize="13" Margin="8,8,8,0"
                                   Text="No apps yet. Add the programs this one needs." Visibility="Collapsed" />
                        <ListBox x:Name="AppList" SelectionChanged="OnAppChanged" AutomationProperties.Name="Apps">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        </Grid>
                    </DockPanel>

                    <Grid Grid.Column="4">
                        <TextBlock x:Name="NoAppText" Style="{StaticResource Caption}" FontSize="14"
                                   Text="Select an app to edit it, or add one." />
                        <ScrollViewer x:Name="AppForm" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel Margin="0,0,12,16">
                                <TextBlock Text="Program" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0" Click="OnBrowse" />
                                    <ui:TextBox Text="{Binding Exe, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="C:\Program Files\Docker\Docker\Docker Desktop.exe…"
                                                AutomationProperties.Name="Program" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="A full path, or a command on your PATH such as code." />

                                <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="D:\Projects\my-app…" AutomationProperties.Name="Arguments" />

                                <TextBlock Text="Start in folder" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Cwd, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Optional…" AutomationProperties.Name="Start in folder" />

                                <TextBlock Text="If it is already running" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OwnershipBox" HorizontalAlignment="Stretch"
                                          DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Ownership}" AutomationProperties.Name="If it is already running" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="{Binding ElementName=OwnershipBox, Path=SelectedItem.Description}" />

                                <TextBlock Text="Seconds to wait for it to close" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding CloseTimeout, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100"
                                            HorizontalAlignment="Left" AutomationProperties.Name="Seconds to wait for it to close" />

                                <TextBlock Text="Command after it closes" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding StopCommand, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="docker compose down…" AutomationProperties.Name="Command after it closes" />
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Optional. Use it for things that keep running after their window closes." />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Hotkeys -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,16" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" Margin="0,0,0,12"
                                   Text="Click a box and press the keys. Backspace clears it, and an empty box turns that hotkey off." />
                        <ItemsControl x:Name="HotkeyList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <ui:Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="OnClearHotkey"
                                                   AutomationProperties.Name="{Binding Label, StringFormat=Clear {0}}" />
                                        <TextBlock Text="{Binding Label}" Width="230" VerticalAlignment="Center" />
                                        <ui:TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True"
                                                    PlaceholderText="Off" PreviewKeyDown="OnHotkeyKeyDown"
                                                    AutomationProperties.Name="{Binding Label}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- General -->
            <TabItem Header="General">
                <StackPanel Margin="0,16,0,16" MaxWidth="620" HorizontalAlignment="Left">
                    <ui:ToggleSwitch x:Name="LoginSwitch" Content="Start when I sign in to Windows" Click="OnLoginToggled" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="The picker appears at sign-in so you can choose Gaming or a workspace." />

                    <TextBlock Text="Separate desktops" Style="{StaticResource FieldLabel}" Margin="0,24,0,6" />
                    <TextBlock x:Name="DesktopInfo" TextWrapping="Wrap" />

                    <TextBlock Text="Config file" Style="{StaticResource FieldLabel}" Margin="0,24,0,6" />
                    <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" />
                    <ui:Button Content="Open folder" Margin="0,8,0,0" Click="OnOpenFolder" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="16,12,16,16">
            <ui:Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Save" Appearance="Primary" Click="OnSave" />
            <ui:Button DockPanel.Dock="Right" Content="Revert" Margin="0,0,8,0" Click="OnRevert" />
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</ui:FluentWindow>
