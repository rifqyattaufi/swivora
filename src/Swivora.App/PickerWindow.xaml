<ui:FluentWindow x:Class="Swivora.App.PickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Swivora" Width="400" SizeToContent="Height"
                 ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
                 Topmost="True" KeyDown="OnKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Swivora" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,20">
            <!-- page 1: mode -->
            <StackPanel x:Name="ModePage">
                <TextBlock Text="Choose a mode" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
                <StackPanel x:Name="ModeList" />
                <UniformGrid x:Name="ModeGrid" Columns="3" Visibility="Collapsed"
                             KeyboardNavigation.DirectionalNavigation="Cycle" />
                <TextBlock x:Name="NoModesText" Opacity="0.7" TextWrapping="Wrap"
                           Text="No modes yet. Add one in Settings." />
            </StackPanel>

            <!-- page 2: workspaces -->
            <StackPanel x:Name="WorkPage" Visibility="Collapsed">
                <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Left" Content="Back" Appearance="Transparent" Click="OnBack"
                               Padding="8,4" Margin="0,0,12,0" />
                    <TextBlock x:Name="WorkTitle" Text="Pick a workspace" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="WorkspaceList" />
                <TextBlock x:Name="EmptyText" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="No workspaces yet. Add one for the project you are working on." />
                <ui:Button x:Name="AddButton" Content="Add workspace" Appearance="Primary"
                           HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="OnAdd" />
            </StackPanel>

            <DockPanel Margin="0,20,0,0">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Settings24}" Appearance="Transparent" Click="OnSettings" Padding="8,6"
                           ToolTip="Settings" AutomationProperties.Name="Settings" />
                <TextBlock x:Name="Status" Opacity="0.7" FontSize="12" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" VerticalAlignment="Center"
                           MaxWidth="250" HorizontalAlignment="Left" />
            </DockPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
